# Application
APP_ENV=development
SERVER_PORT=8080
LOG_LEVEL=info

# Database (required)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_NAME=newsletter
DB_SSLMODE=disable

# JWT (required in production: set JWT_SECRET to a strong secret, min 32 characters)
JWT_SECRET=your_jwt_secret_min_32_chars_for_production
JWT_EXPIRATION=1h
JWT_REFRESH_EXPIRATION_DAYS=7

# Redis (optional; rate limiting disabled when not set)
REDIS_URL=localhost:6379
REDIS_PASSWORD=

# CORS (comma-separated origins; required in production)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Paystack (optional)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# M-Pesa (optional)
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-domain.com/api/webhooks/mpesa
# When set, M-Pesa callback must include header: X-Mpesa-Callback-Secret
MPESA_CALLBACK_SECRET=

# Email (e.g. Resend; optional)
RESEND_API_KEY=
